{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git"
  ],
  "permission": {
    "bash": {
      "*": "ask",
      "git push --force*": "deny",
      "git push *": "ask",
      "git merge *": "ask",
      "git reset --hard *": "ask",
      "git clean *": "ask"
    }
  }
}
